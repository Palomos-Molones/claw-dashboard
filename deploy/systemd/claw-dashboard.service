[Unit]
Description=Claw Dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/clawbot/.openclaw/workspace/claw-dashboard
EnvironmentFile=/home/clawbot/.config/claw-dashboard/env
ExecStart=/home/clawbot/.nvm/versions/node/v24.16.0/bin/node server/index.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
